# Copy this to .env and fill in your values

# ── ntfy.sh (EASIEST – recommended, no account needed) ──────────────────────
# 1. Pick any secret topic name – the more random, the better
# 2. On iPhone: install the free "ntfy" app from the App Store
# 3. In the ntfy app tap "+" and subscribe to your topic name
# You'll get an instant push notification whenever a code is found.
NTFY_TOPIC=chipotle-codes-CHANGE-THIS-TO-SOMETHING-SECRET

# Name of your Apple Shortcut (optional but recommended).
# When set, the ntfy notification will have a "Send Code to Shortcut" button.
# Tapping it opens your Shortcut with the promo code already passed as input.
# Create a Shortcut that accepts text input, then put its exact name here.
SHORTCUT_NAME=Chipotle Code

# ── Email (optional – leave blank to skip) ───────────────────────────────────
# Gmail: go to appleid.apple.com → Security → App-Specific Passwords (for iCloud)
# Or use any SMTP provider (Outlook, Yahoo, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

# ── Timing ───────────────────────────────────────────────────────────────────
POLL_SECONDS=300   # how often to check X (seconds). 300 = every 5 min

# ── Local HTTP server port ───────────────────────────────────────────────────
HTTP_PORT=8080
