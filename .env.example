# Copy this to .env and fill in your values

# --- Email (Gmail recommended) ---
# Use a Gmail App Password: myaccount.google.com > Security > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx   # 16-char App Password (spaces OK)
NOTIFY_EMAIL=you@gmail.com       # where to send alerts (can be same address)

# --- Timing ---
POLL_SECONDS=300     # how often to check X (seconds). 300 = every 5 min

# --- Local HTTP server (for Apple Shortcuts) ---
HTTP_PORT=8080
